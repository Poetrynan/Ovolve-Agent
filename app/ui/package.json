{
  "name": "ovolve",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/allocate-dev-ports.mjs && node scripts/run-dev-electron.mjs",
    "dev:vite": "vite",
    "dev:electron": "npm run build:electron && node scripts/allocate-dev-ports.mjs && node scripts/run-dev-electron.mjs",
    "build:vite": "tsc && vite build",
    "icons": "npx electron scripts/render_icons.cjs",
    "build:electron": "tsc -p electron/tsconfig.json && node electron/postbuild.mjs",
    "build:electron:watch": "tsc -p electron/tsconfig.json -w",
    "postinstall": "node ./node_modules/electron/install.js && node ./scripts/patch-electron-icon.cjs",
    "build": "npm run build:vite && npm run build:electron",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src --ext ts,tsx",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "framer-motion": "13.1.0",
    "generative-loaders": "0.1.1",
    "gpt-tokenizer": "2.6.2",
    "highlight.js": "^11.12.0",
    "i18next": "23.16.8",
    "i18next-browser-languagedetector": "8.0.2",
    "katex": "^0.16.47",
    "lucide-react": "^0.309.0",
    "mermaid": "^11.16.1",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.85.0",
    "react-i18next": "15.1.3",
    "react-markdown": "9.0.1",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^6.21.0",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "4.0.0",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.32",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.0",
    "tree-kill": "^1.2.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^2.1.9",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.ovolve.desktop",
    "productName": "Ovolve",
    "directories": {
      "output": "release"
    },
    "icon": "public/icon.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../main.py",
        "to": "app/main.py"
      },
      {
        "from": "../backend",
        "to": "app/backend"
      },
      {
        "from": "../config.json",
        "to": "app/config.json"
      },
      {
        "from": "../requirements.txt",
        "to": "app/requirements.txt"
      },
      {
        "from": "../system_prompt.md",
        "to": "app/system_prompt.md"
      },
      {
        "from": "../resources/embedder",
        "to": "embedder",
        "filter": [
          "**/*",
          "!**/.gitkeep"
        ]
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
