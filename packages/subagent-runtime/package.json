{
  "name": "@oa/subagent-runtime",
  "version": "0.1.0",
  "description": "Sub-agent execution runtime: parallel fan-out, per-parent caps, context isolation, watchdog.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oa/team": "workspace:*",
    "@oa/event-store": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "ai",
    "agent",
    "multi-agent",
    "subagent",
    "orchestration"
  ]
